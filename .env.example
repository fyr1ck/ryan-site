# ============================================================
# PÚBLICAS — podem chegar ao browser
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SERVIDOR — NUNCA importar em Client Component
# Pegue em: Supabase Dashboard > Project Settings > API > service_role
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# ============================================================
# MISTICPAY (servidor) — gateway de Pix
#
# Access Keys (pk_/sk_) no painel da MisticPay. NAO use as credenciais
# legadas ci_/cs_: sao descontinuadas em 30/09/2026 e nao permitem saque.
#
# Por que nao Stripe: Pix na Stripe para empresas brasileiras e invite-only
# e exige 60 dias processando pagamentos na plataforma. Como esta loja so
# vende por Pix, o requisito e impossivel de cumprir.
# ============================================================
MISTICPAY_PUBLIC_KEY=pk_...
MISTICPAY_SECRET_KEY=sk_...

# Segredo NOSSO, nao da MisticPay. Vai no caminho da URL do webhook:
#   https://SEU-DOMINIO/api/webhooks/misticpay/<token>
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# E defesa em profundidade, nao a defesa principal: a MisticPay NAO assina o
# webhook, entao quem confirma o pagamento e uma consulta de volta a API dela
# (checkTransaction). O token so evita ruido de quem adivinhou o dominio.
MISTICPAY_WEBHOOK_TOKEN=COLE_AQUI
