# ============================================================
# PÚBLICAS — podem chegar ao browser
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_publishable_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# SERVIDOR — NUNCA importar em Client Component
# Pegue em: Supabase Dashboard > Project Settings > API > service_role
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key

# ============================================================
# STRIPE (servidor) — pagamento via Pix
# Chaves: dashboard.stripe.com/apikeys
# Webhook: dashboard.stripe.com/webhooks -> /api/webhooks/stripe
#          eventos: payment_intent.succeeded, payment_intent.payment_failed,
#                   payment_intent.canceled
# Pix exige conta brasileira com Pix habilitado em Payment methods.
# ============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
